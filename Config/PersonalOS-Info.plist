<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 공유 익스텐션이 본체 앱을 열 때 쓰는 스킴.
	     CFBundleURLTypes 는 배열 안에 딕셔너리라 INFOPLIST_KEY_ 빌드 설정으로는
	     표현할 수 없다. 그래서 이 파일만 따로 두고 GENERATE_INFOPLIST_FILE 은
	     켠 채로 병합시킨다.

	     동기화 그룹(PersonalOS/) 안에 두면 번들 리소스로도 복사돼서 충돌하므로
	     반드시 폴더 밖(Config/)에 둔다. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.calebsung.PersonalOS</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>personalos</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
